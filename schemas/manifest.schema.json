{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abf.invalid/schemas/abf-manifest-1.0.json",
  "title": "abf-manifest-1.0",
  "description": "Version manifest <dataset>/v<version>/manifest.json (SPEC_META_publish_v0_1 section 4.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset", "version", "tag", "doi", "published_at",
    "boundary_release", "base_path", "layers", "source_archives"
  ],
  "properties": {
    "schema_version": {"const": "abf-manifest-1.0"},
    "dataset": {"enum": ["abf-layers", "abf-boundaries"]},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "tag": {"type": "string", "pattern": "^abf-[a-z]+-v\\d+\\.\\d+\\.\\d+$"},
    "doi": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^10\\.5281/zenodo\\.\\d+$"}]},
    "published_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "boundary_release": {"type": ["string", "null"]},
    "base_path": {"type": "string", "pattern": "^(dev/)?abf-[a-z]+/v\\d+\\.\\d+\\.\\d+/$"},
    "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}},
    "extra_files": {"type": "array", "items": {"$ref": "#/$defs/extra_file"}},
    "source_archives": {"type": "array", "items": {"$ref": "#/$defs/archive"}}
  },
  "$defs": {
    "fileref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "extra_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "description"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "description"],
      "properties": {
        "path": {"type": "string", "pattern": "^sources/"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_id", "title", "domain", "level", "bbox", "meta", "files", "extra_files", "tiles"],
      "properties": {
        "layer_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "title": {"type": "string", "minLength": 1},
        "domain": {"enum": ["energy", "dc", "restrictions", "observability", "boundaries"]},
        "level": {"enum": ["ADM0", "ADM1", "ADM2", "point", "line"]},
        "bbox": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {"type": "number"}
        },
        "meta": {"$ref": "#/$defs/fileref"},
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parquet", "geojson.gz", "pmtiles"],
          "properties": {
            "parquet": {"$ref": "#/$defs/fileref"},
            "geojson.gz": {"$ref": "#/$defs/fileref"},
            "csv": {"$ref": "#/$defs/fileref"},
            "pmtiles": {"$ref": "#/$defs/fileref"}
          }
        },
        "extra_files": {"type": "array", "items": {"$ref": "#/$defs/extra_file"}},
        "tiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "source_layer", "geometry_type", "minzoom", "maxzoom", "fields"],
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "source_layer": {"type": "string", "minLength": 1},
            "geometry_type": {"enum": ["polygon", "line", "point"]},
            "minzoom": {"type": "integer", "minimum": 0, "maximum": 24},
            "maxzoom": {"type": "integer", "minimum": 0, "maximum": 24},
            "fields": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    }
  }
}
