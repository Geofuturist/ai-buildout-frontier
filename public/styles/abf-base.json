{
  "version": 8,
  "name": "ABF base",
  "metadata": { "note": "Own style (SPEC_WEB 4.2). Vector tiles from OpenFreeMap (OpenMapTiles schema). No administrative boundaries and no country labels: borders come from abf-boundaries only." },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#fcfcfb" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": { "fill-color": "#e3e7ea" } },
    {
      "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "minzoom": 8,
      "paint": { "line-color": "#e3e7ea", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2.5] }
    },
    {
      "id": "roads", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 7,
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary", "secondary", "tertiary"]]],
      "paint": { "line-color": "#d3d6da", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.3, 14, 1.8] }
    },
    {
      "id": "labels-start", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 4,
      "filter": ["==", ["get", "class"], "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 14],
        "text-max-width": 8
      },
      "paint": { "text-color": "#52514e", "text-halo-color": "#fcfcfb", "text-halo-width": 1.2 }
    },
    {
      "id": "labels-town", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "minzoom": 7,
      "filter": ["==", ["get", "class"], "town"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 10, 12, 13],
        "text-max-width": 8
      },
      "paint": { "text-color": "#6b6f76", "text-halo-color": "#fcfcfb", "text-halo-width": 1.2 }
    }
  ]
}
